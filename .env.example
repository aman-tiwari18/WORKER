# ──────────────────────────────────────────────────────
# Script Server – Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────

# Main Backend Connection
MAIN_BACKEND_URL=http://localhost:3000/cctv_analytics/api
API_KEY=your_script_server_api_key

# Polling Configuration
POLL_INTERVAL_MS=30000
MAX_CONCURRENT_SCRIPTS=5
# How many minutes ahead to pre-fetch assignments so they can be queued (default: 3)
LOOKAHEAD_MINUTES=3
# How many minutes overdue to still accept assignments — handles server restarts (default: 30)
GRACE_MINUTES=30

# Script Configuration
SCRIPTS_DIR=./scripts
LOGS_DIR=./scripts/logs/executions

# HTTP Server Port
HTTP_PORT=8000

# ──────────────────────────────────────────────────────
# Worker Configuration (Horizontal Scaling)
# ──────────────────────────────────────────────────────
# Main server also processes cameras as Worker 0
WORKER_ID=worker-0
WORKER_NAME=Main Server (Worker 0)

# Distribution mode: 'auto' for hash-based horizontal scaling,
# 'static' for range-based, 'single' for all cameras.
DISTRIBUTION_MODE=auto
TOTAL_WORKERS=4

# Example distribution for 25,000 cameras across 4 nodes:
# AUTO mode uses camera_id % TOTAL_WORKERS:
# Main Server (worker-0): ids where camera_id % 4 == 0
# Worker 1: ids where camera_id % 4 == 1
# Worker 2: ids where camera_id % 4 == 2
# Worker 3: ids where camera_id % 4 == 3

# Coordination + DB gateway
COORDINATION_MODE=hash            # hash | lease
DB_ACCESS_MODE=direct             # direct (pymysql) | backend (HTTP gateway, no MySQL needed)
DB_GATEWAY_TIMEOUT_S=15
INGEST_FLUSH_INTERVAL_S=20

# Detection image serving (db_client direct mode; backend owns it in gateway mode)
DETECTION_IMAGE_BASE_URL=https://your-domain/current_dev_mode/api/serve-detection-images
DETECTION_RTSP_IMAGE_BASE_URL=https://your-domain/current_dev_mode/api/serve-rtsp-detection-images

# vLLM classifier (self-launched per GPU; localhost is correct per-worker)
VISION_VLLM_URL=http://localhost:8001/v1/chat/completions
VISION_VLLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# YOLO checkpoint used by every detection script (single source of truth in
# scripts/detection/model_config.py — do not hardcode a model filename in any
# individual script). File must live in ./models/ (bind-mounted). Must be a
# stock COCO-80 checkpoint or a fine-tune with the same class ordering, since
# every script filters by hardcoded COCO class id (person=0, chair=56, etc.).
YOLO_DETECTION_MODEL=yolo26m.pt
# Lightweight model for camera_inversion_worker's fast person-presence pre-check.
YOLO_INVERSION_MODEL=yolo26n.pt

# Canonical root that db_client rewrites every frame_path to before the DB write
# (see _canonicalize_frame_path). Defaults to the shared NFS root, which this
# stack does not use — set it to the classification_frames dir under
# FRAMES_HOST_PATH so it matches the backend's NFS_FRAMES_ROOT, or frames 404.
# docker-compose.{uat,dev}.yml derive this automatically from FRAMES_HOST_PATH.
NFS_FRAMES_ROOT=/data/new_dev/frames/classification_frames
