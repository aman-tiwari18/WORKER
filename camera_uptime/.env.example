# Local runs only: copy to .env. In Docker the settings come from the compose file and the Fleet settings.

# --- MySQL: the dedicated least-privilege user (SELECT on exam/camera tables, write only camera_uptime_*)
DB_HOST=localhost
DB_PORT=3306
DB_USER=cctv_uptime
DB_PASSWORD=
DB_NAME=cctv_monitoring

# --- Camview token server (shared fleet session). The service never logs in, evicts or forces a refresh.
CAMVIEW_TOKEN_SERVER=http://localhost:8090
CAMVIEW_API_TIMEOUT_S=10
# 1 = main stream (detection's kept-open sessions use the substream, 2)
RTSP_STREAM_TYPE=1
# StopVideo can only target the shared session + channel, so it stays off until tested next to detection
STOP_VIDEO=0

# --- Pacing: one camera at a time per Camview server, one HLS lane
MAX_INFLIGHT_PER_SERVER=1
DVR_MIN_GAP_S=60
MAX_NEW_STREAMS_PER_MIN=20
# Requests per second to the HLS portal/CDN (TCS rule: never more than 1/s from the shared egress IP)
HLS_REQ_PER_S=0.5
# Comma list of Camview hosts to check (pilot), e.g. d11.camview.io. Empty = all servers.
ONLY_SERVERS=
INCLUDE_HLS=1
DVR_UNAVAILABLE_BACKOFF_S=120
DVR_CAPACITY_BACKOFF_S=60
TOKEN_BACKOFF_S=400
TCS_BLOCK_PAUSE_S=1800

# --- Windows: checks run inside each live shift (exam_shifts start..end), after a short hold at the start
START_HOLD_MIN=5
MAX_WINDOW_HOURS=16
SCHEDULE_REFRESH_S=60
ROSTER_REFRESH_S=300
# Pause RTSP checks of an exam while one of its vision assignments is RUNNING
PAUSE_DURING_VISION=1

# --- Capture
FFMPEG_TIMEOUT_S=6
HLS_FFMPEG_TIMEOUT_S=8
HLS_PORTAL_TIMEOUT_S=8
FRAME_WIDTH=640
# Pixel-statistics flag for blank / "no video" frames. Never changes the UP verdict, never writes a label.
BLANK_CHECK=1
SAVE_FRAMES=1
FRAMES_ROOT=/data/nfs/cctv_images/uptime_frames

# --- Ops API (localhost only) and safety
HTTP_HOST=127.0.0.1
HTTP_PORT=8095
# If this file exists, no new checks start (kill switch)
PAUSE_FILE=/data/cctv_dev/cctv/camera-uptime-service/PAUSE
MIN_MEM_AVAILABLE_GB=8
LOG_LEVEL=INFO
